{
    name: "arrays",
    structs: [
        {
            name: "Item",
            fields: [
                {
                    name: "id",
                    raw: {
                        type: "unsigned",
                        bits: 8
                    }
                },
                {
                    name: "count",
                    raw: {
                        type: "unsigned",
                        bits: 11
                    }
                },
                {
                    name: "slot",
                    raw: {
                        type: "unsigned",
                        bits: 5
                    }
                }
            ]
        }
    ],
    messages: [
        {
            name: "Msg",
            fields: [
                {
                    name: "items",
                    value: {
                        type: "list",
                        max_len: 255,
                        item_type: "Item"
                    }
                }
            ]
        },
        {
            name: "Msg1",
            fields: [
                {
                    name: "items",
                    value: {
                        type: "list",
                        max_len: 255,
                        item_type: "Item"
                    },
                    optional: true
                }
            ]
        }
    ]
}