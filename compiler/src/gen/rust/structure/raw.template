    /// {description}
    pub fn set_{name}(&mut self, value: {raw_type}) {{
{fragment}
#fragment push transmute_bool
        if value {{
            self.bin.set_{name}(1);
        }} else {{
            self.bin.set_{name}(0);
        }}
#fragment pop
#fragment push transmute_other
        self.bin.set_{name}(bp3d_proto::transmute!(<{raw_type}, {bits_type}>(value)));
#fragment pop
#fragment push signed
        self.bin.set_{name}(bp3d_proto::transmute!(<{raw_type}, {bits_type}>(value)));
#fragment pop
#fragment push none
        self.bin.set_{name}(value);
#fragment pop
    }}
